[
 {
  "start": 0.0,
  "end": 2.82,
  "text": "SAT-dan 1400-dan koppal alishigiz chun"
 },
 {
  "start": 2.82,
  "end": 5.5,
  "text": "shu ikte saytda daimi faydalanishigiz kirek."
 },
 {
  "start": 5.56,
  "end": 7.96,
  "text": "Bu ayat etkin saytlarini koppchilik biladi."
 },
 {
  "start": 8.1,
  "end": 10.34,
  "text": "Tanchalik faydali ikanligini xan biladi,"
 },
 {
  "start": 10.34,
  "end": 12.32,
  "text": "lekin muntazam ravishda shogunlanmayib."
 },
 {
  "start": 12.42,
  "end": 15.08,
  "text": "Sizgi bularini ayat chibna aldin, abunabol koyib."
 },
 {
  "start": 15.16,
  "end": 16.4,
  "text": "Birinchi si Bluebook."
 },
 {
  "start": 16.56,
  "end": 18.58,
  "text": "Bu, College Board-ni ozu chikargan"
 },
 {
  "start": 18.58,
  "end": 20.4,
  "text": "rasmi platformasi soplanad."
 },
 {
  "start": 20.5,
  "end": 22.98,
  "text": "Test güni, siz aynan usha platformada"
 },
 {
  "start": 22.98,
  "end": 23.9,
  "text": "imtqon toqchirasiz,"
 },
 {
  "start": 23.98,
  "end": 25.62,
  "text": "shuni uchun mashilarini xan"
 },
 {
  "start": 25.62,
  "end": 27.28,
  "text": "shu platformada bacarish kirek."
 },
 {
  "start": 27.32,
  "end": 28.44,
  "text": "Adaptiv testlar,"
 },
 {
  "start": 28.44,
  "end": 31.72,
  "text": "teynchilik darajasy hammasi utuamblan birxil."
 },
 {
  "start": 31.78,
  "end": 35.2,
  "text": "Ikinci, Khan Academy-dagi Official SAT Rights."
 },
 {
  "start": 35.52,
  "end": 38.22,
  "text": "Bukham College Board-lar hamkorlikta tuzulgan,"
 },
 {
  "start": 38.3,
  "end": 42.12,
  "text": "hamda mutlaqo biyapol, xarbur mawzu video bulan chunturladi,"
 },
 {
  "start": 42.24,
  "end": 43.62,
  "text": "kiyn mashqilasiz."
 },
 {
  "start": 43.76,
  "end": 45.74,
  "text": "Bularini bittasi sizgi bilim deradi,"
 },
 {
  "start": 45.86,
  "end": 49.14,
  "text": "ikincisi, usha bilimlarini test formatida tekshiradi."
 },
 {
  "start": 49.26,
  "end": 50.86,
  "text": "Agar video faydalib olgan borsi,"
 },
 {
  "start": 50.92,
  "end": 53.42,
  "text": "SAT-gi taryanarkin dostingizgi varub koyin."
 }
]