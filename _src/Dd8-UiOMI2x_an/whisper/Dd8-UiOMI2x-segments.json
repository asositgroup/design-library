[
 {
  "start": 0.0,
  "end": 1.74,
  "text": "Ahirim koshdirnaqchi dayib kruyucilar,"
 },
 {
  "start": 1.88,
  "end": 5.82,
  "text": "qalbdi aldashi qisabiga ya vaqtida bitirmasini qisabiga,"
 },
 {
  "start": 5.9,
  "end": 9.36,
  "text": "qalb butun kruyucilan oraqtistan kanagan negativ faydal oyab."
 },
 {
  "start": 9.48,
  "end": 9.92,
  "text": "Sinan qay?"
 },
 {
  "start": 10.02,
  "end": 11.86,
  "text": "Bu, nima geyadib oylesiz?"
 },
 {
  "start": 12.14,
  "end": 13.8,
  "text": "Pulitaqishchun shu istiqil yaptini,"
 },
 {
  "start": 13.88,
  "end": 15.52,
  "text": "ya uvasam qalbishchun chalig,"
 },
 {
  "start": 15.56,
  "end": 17.56,
  "text": "andi chaligidan xodanay nabtini?"
 },
 {
  "start": 17.68,
  "end": 19.06,
  "text": "Aslida xam asib hipotiza,"
 },
 {
  "start": 19.14,
  "end": 19.86,
  "text": "yaxshini atbilan,"
 },
 {
  "start": 19.92,
  "end": 21.86,
  "text": "efilasam kerey digan umitbilan bashlaydi."
 },
 {
  "start": 22.0,
  "end": 23.78,
  "text": "Ekib puli bar mar, puli yog na mar,"
 },
 {
  "start": 23.94,
  "end": 25.18,
  "text": "kob nasan qisabka amidi,"
 },
 {
  "start": 25.18,
  "end": 28.4,
  "text": "bilgan xaldi, bilmangan xaldi, hafizki mashayni namig ektirgan xalitla bugan."
 },
 {
  "start": 28.4,
  "end": 29.6,
  "text": "Yaqanda, fin madil togrunmaz."
 },
 {
  "start": 29.68,
  "end": 31.68,
  "text": "Ha, fin madil togrunmaz, tajriba yuk."
 },
 {
  "start": 31.78,
  "end": 33.88,
  "text": "Burdan, ge, toya nige shan, toya baxqa batdi."
 },
 {
  "start": 34.32,
  "end": 37.26,
  "text": "Xaldi, masla, 10 milion dolarli layqan, 2 milion budan baxlasan,"
 },
 {
  "start": 37.26,
  "end": 39.56,
  "text": "fogan, adamlan, bliga xuraman digan xalitla bugan."
 },
 {
  "start": 39.84,
  "end": 41.22,
  "text": "Kob, enda aminla bar."
 },
 {
  "start": 41.38,
  "end": 45.4,
  "text": "Xunki, enda, xarbi insan yaksini yadildan baxlayirli ki, tajribasizlik."
 }
]