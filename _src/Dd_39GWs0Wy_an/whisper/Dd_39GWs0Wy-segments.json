[
 {
  "start": 0.0,
  "end": 6.92,
  "text": "Qarim qurlisda da qoriyanmizda, qoylik toloqu keqiqsa, qana qadir sanksiyaya, carimayla qurlanyaya, qorlush keqiqsa qi, Musolim?"
 },
 {
  "start": 6.98,
  "end": 13.48,
  "text": "Sadiki da bolyk toloqta shtrafnoy sanksiyali yox, smasalan dili, yanvar ayda qi toloqu, fevral aygi qoldirsiz,"
 },
 {
  "start": 13.68,
  "end": 17.82,
  "text": "siz buzada yashil rayqatdagi mecazladan, saraq rayqatki ot asti."
 },
 {
  "start": 17.9,
  "end": 24.62,
  "text": "Buzayi tamiz, oqitam caniga, halkim xayalizdan kotarligan bolishimun ki, masalik o ticarat mali bolimizdagila khawar ola."
 },
 {
  "start": 24.62,
  "end": 28.68,
  "text": "Siz yanvar aydegi pulli yanvaryam, fevraryam, tolamiyam, martibusiz,"
 },
 {
  "start": 28.78,
  "end": 30.46,
  "text": "buzada sarig rayqatgan qizir rayqatgan,"
 },
 {
  "start": 30.46,
  "end": 32.0,
  "text": "eka uxin chay bolit olamiyabs."
 },
 {
  "start": 32.08,
  "end": 33.72,
  "text": "Aba oda torin chay govatiladiyam,"
 },
 {
  "start": 33.72,
  "end": 34.4,
  "text": "bosa eka jon,"
 },
 {
  "start": 34.46,
  "end": 35.8,
  "text": "ekin yuriz va buqaltirilar,"
 },
 {
  "start": 35.84,
  "end": 37.48,
  "text": "aytadiki bizi shabt nomamiz,"
 },
 {
  "start": 37.5,
  "end": 38.48,
  "text": "mamub bandidagi,"
 },
 {
  "start": 38.58,
  "end": 39.36,
  "text": "masigas olsam,"
 },
 {
  "start": 39.38,
  "end": 40.2,
  "text": "bizi shabt nomamiz,"
 },
 {
  "start": 40.26,
  "end": 42.06,
  "text": "anulirot qizirimizga sabab boladi,"
 },
 {
  "start": 42.18,
  "end": 44.4,
  "text": "bu oşa islatmani qiladi."
 },
 {
  "start": 44.54,
  "end": 45.08,
  "text": "Ketsiz,"
 },
 {
  "start": 45.08,
  "end": 45.68,
  "text": "yo uzaro,"
 },
 {
  "start": 45.76,
  "end": 47.84,
  "text": "boli haqqatda ingi chili tolamadimda siz,"
 },
 {
  "start": 48.06,
  "end": 49.72,
  "text": "sabab qiladi yechim qidrla."
 }
]